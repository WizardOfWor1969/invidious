<% content_for "header" do %>
<title>Blacklist manager - Invidious</title>
<% end %>

<div class="pure-g h-box">
    <div class="pure-u-1-3">
        <h3>
            <a href="/subscription_manager">
                <%= I18n.translate(locale, "Subscription manager") %>
            </a>
        </h3>
    </div>
    <div class="pure-u-1-3"></div>
    <div class="pure-u-1-3" style="text-align:right">
        <h3>
            <%= "Blacklisted channels: #{channels.size + unknown_ids.size}" %>
        </h3>
    </div>
</div>

<% if channels.empty? && unknown_ids.empty? %>
    <div class="h-box">
        <p>No blacklisted channels.</p>
        <p>
            Use the blacklist button on a channel page, or the
            <i class="icon ion-md-close-circle"></i> button on any video or
            channel card in search results and feeds.
        </p>
    </div>
<% end %>

<% channels.each do |channel| %>
    <div class="h-box">
        <div class="pure-g<% if channel.deleted %> deleted <% end %>">
            <div class="pure-u-2-5">
                <h3 style="padding-left:0.5em">
                    <a href="/channel/<%= channel.id %>"><%= HTML.escape(channel.author) %></a>
                </h3>
            </div>
            <div class="pure-u-2-5"></div>
            <div class="pure-u-1-5" style="text-align:right">
                <h3 style="padding-right:0.5em">
                    <form action="/subscription_ajax?action=unblacklist_channel&c=<%= channel.id %>&referer=<%= env.get("current_page") %>" method="post">
                        <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
                        <input style="all:unset;cursor:pointer" type="submit" value="Remove">
                    </form>
                </h3>
            </div>
        </div>

        <% if channels[-1].author != channel.author %>
            <hr>
        <% end %>
    </div>
<% end %>

<% unknown_ids.each do |ucid| %>
    <div class="h-box">
        <div class="pure-g">
            <div class="pure-u-2-5">
                <h3 style="padding-left:0.5em">
                    <%= ucid %> <small>(channel info unavailable)</small>
                </h3>
            </div>
            <div class="pure-u-2-5"></div>
            <div class="pure-u-1-5" style="text-align:right">
                <h3 style="padding-right:0.5em">
                    <form action="/subscription_ajax?action=unblacklist_channel&c=<%= ucid %>&referer=<%= env.get("current_page") %>" method="post">
                        <input type="hidden" name="csrf_token" value="<%= HTML.escape(env.get?("csrf_token").try &.as(String) || "") %>">
                        <input style="all:unset;cursor:pointer" type="submit" value="Remove">
                    </form>
                </h3>
            </div>
        </div>

        <% if unknown_ids[-1] != ucid %>
            <hr>
        <% end %>
    </div>
<% end %>
